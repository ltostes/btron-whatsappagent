# ===================
# WAHA CREDENTIALS (generate with init-waha or set manually)
# ===================
# Dashboard auth
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=CHANGE_ME_RANDOM_32_CHARS

# API authentication key
WAHA_API_KEY=CHANGE_ME_RANDOM_32_CHARS

# ===================
# WAHA SERVER
# ===================
# Public URL (important for webhooks/QR codes)
WAHA_BASE_URL=https://waha.yourdomain.com

# Server binding
WAHA_API_HOSTNAME=0.0.0.0
WAHA_API_PORT=3000

# Logging: fatal, error, warn, info, debug, trace
WAHA_LOG_LEVEL=info

# ===================
# WEBHOOKS
# ===================
# Where to send WhatsApp events (your n8n webhook)
WHATSAPP_HOOK_URL=https://n8n.yourdomain.com/webhook/waha

# Events: message, message.ack, session.status, message.reaction, state.change
# Use * for all (not recommended for production)
WHATSAPP_HOOK_EVENTS=message,session.status,message.ack

# Optional: HMAC signature for webhook security
# WHATSAPP_HOOK_HMAC_KEY=your-secret-key
